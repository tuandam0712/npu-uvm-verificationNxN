[tasks]
reset
clear
operand
valid
mac_hold
cover

[options]
mode prove
cover: mode cover
depth 8

[engines]
smtbmc --nopresat --unroll z3 -- --noincr

[script]
reset: read -formal -sv -noautowire -DSARR_FORMAL_SBY -DPE_FORMAL_SBY -DFORMAL_N=2 -DFORMAL_WIDTH=4 -DPROVE_RESET pe.sv systolic_arr_NxN.sv sarr_formal.sv
clear: read -formal -sv -noautowire -DSARR_FORMAL_SBY -DPE_FORMAL_SBY -DFORMAL_N=2 -DFORMAL_WIDTH=4 -DPROVE_CLEAR pe.sv systolic_arr_NxN.sv sarr_formal.sv
operand: read -formal -sv -noautowire -DSARR_FORMAL_SBY -DPE_FORMAL_SBY -DFORMAL_N=2 -DFORMAL_WIDTH=4 -DPROVE_OPERAND pe.sv systolic_arr_NxN.sv sarr_formal.sv
valid: read -formal -sv -noautowire -DSARR_FORMAL_SBY -DPE_FORMAL_SBY -DFORMAL_N=2 -DFORMAL_WIDTH=4 -DPROVE_VALID pe.sv systolic_arr_NxN.sv sarr_formal.sv
mac_hold: read -formal -sv -noautowire -DSARR_FORMAL_SBY -DPE_FORMAL_SBY -DFORMAL_N=2 -DFORMAL_WIDTH=4 -DPROVE_MAC_HOLD pe.sv systolic_arr_NxN.sv sarr_formal.sv
cover: read -formal -sv -noautowire -DSARR_FORMAL_SBY -DPE_FORMAL_SBY -DFORMAL_N=2 -DFORMAL_WIDTH=4 -DCOVER_SARR pe.sv systolic_arr_NxN.sv sarr_formal.sv

prep -top sarr_formal

[files]
rtl/pe.sv
rtl/systolic_arr_NxN.sv
formal/sarr/sarr_formal.sv
