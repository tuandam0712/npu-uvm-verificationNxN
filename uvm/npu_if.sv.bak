interface npu_if #(
    parameter int N = 8,
    parameter int width = 8
)(input logic clk);
    logic rst_n, start, done;
    logic signed [width-1:0] a [N-1:0];
    logic signed [width-1:0] b [N-1:0];
    logic signed [2*width+1:0] c [N-1:0][N-1:0];

    clocking drv_cb @(posedge clk);
        output rst_n, start;
        output a; 
        output b;
        input done;
        input c;
    endclocking
    
    // ĐÂY LÀ VẤN ĐỀ: Khôi phục lại nguyên vẹn mon_cb của bạn để dòng 60 trong Monitor không bị Fatal nữa
    // Thêm #0 giúp Monitor lấy mẫu đúng giá trị vừa được Driver cập nhật tại cạnh lên clock
    clocking mon_cb @(posedge clk);
        input #0 rst_n, start, done;
        input #0 a;
        input #0 b;
        input #0 c;
    endclocking
endinterface